# LLM Configuration
# Choose from: gemini, openai, ollama, mock
LLM_PROVIDER=mock

# If using Gemini
GEMINI_API_KEY=

# If using OpenAI
OPENAI_API_KEY=

# If using Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180

# Embedding Configuration
# Choose from: local, gemini, openai
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# Reranker Configuration
USE_RERANKER=true
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-base

# Hybrid Search Weights
RETRIEVAL_MODE=hybrid_reranker
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7
RETRIEVAL_TOP_K=30
RERANK_TOP_N=8

# Evaluation
# Choose from: llm_judge, ragas, deepeval
EVALUATION_BACKEND=llm_judge
RAGAS_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAGAS_TIMEOUT_SECONDS=180
RAGAS_MAX_RETRIES=2
RAGAS_MAX_WORKERS=4
