{
    "id": null,
    "uid": "agentic-rag-observability",
    "title": "Agentic RAG Observability",
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "type": "timeseries",
        "title": "LLM p95 Latency",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(llm_latency_seconds_bucket[5m])) by (le, model))",
            "legendFormat": "{{model}}"
          }
        ],
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Agent Loop Avg Latency",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(agent_step_latency_seconds_sum[5m]) / rate(agent_step_latency_seconds_count[5m])",
            "legendFormat": "agent_loop"
          }
        ],
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "type": "stat",
        "title": "Total LLM Requests",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(llm_requests_total)",
            "legendFormat": "Total"
          }
        ],
        "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 }
      },
      {
        "type": "stat",
        "title": "Agent Steps",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "agent_loops_total",
            "legendFormat": "Steps"
          }
        ],
        "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 }
      },
      {
        "type": "timeseries",
        "title": "LLM Request Rate",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(llm_requests_total[1m])",
            "legendFormat": "{{model}} - {{status}}"
          }
        ],
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
      },
      {
        "type": "timeseries",
        "title": "LLM Latency (All Calls)",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "llm_latency_seconds_sum / llm_latency_seconds_count",
            "legendFormat": "{{model}} avg latency"
          }
        ],
        "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "LLM Error Rate",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(rate(llm_requests_total{status=\"error\"}[5m])) by (model)",
            "legendFormat": "{{model}}"
          }
        ],
        "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 }
      },
      {
        "type": "timeseries",
        "title": "Retrieval p95 Latency",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(retrieval_latency_seconds_bucket[5m])) by (le, mode))",
            "legendFormat": "{{mode}}"
          }
        ],
        "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Retrieval Request Rate",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(rate(retrieval_requests_total[1m])) by (mode, status)",
            "legendFormat": "{{mode}} - {{status}}"
          }
        ],
        "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 }
      },
      {
        "type": "timeseries",
        "title": "Returned Chunks Avg",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(rate(retrieved_chunks_count_sum[5m])) by (mode) / sum(rate(retrieved_chunks_count_count[5m])) by (mode)",
            "legendFormat": "{{mode}}"
          }
        ],
        "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 }
      },
      {
        "type": "timeseries",
        "title": "Reranker p95 Latency",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(reranker_latency_seconds_bucket[5m])) by (le, model, status))",
            "legendFormat": "{{model}} - {{status}}"
          }
        ],
        "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      }
    ]
  }
